{
  "name": "apollo-link-absinthe",
  "version": "0.1.0",
  "description": "GraphQL subscriptions from Apollo Client to Absinthe over a Phoenix channel, with GraphQL errors kept intact.",
  "license": "MIT",
  "type": "commonjs",
  "author": "Jeroen Visser <jeroen@koode.nl>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koode/apollo-link-absinthe.git"
  },
  "homepage": "https://github.com/koode/apollo-link-absinthe#readme",
  "bugs": "https://github.com/koode/apollo-link-absinthe/issues",
  "keywords": [
    "absinthe",
    "phoenix",
    "apollo",
    "apollo-link",
    "graphql",
    "subscriptions",
    "websocket"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./apollo3": {
      "import": {
        "types": "./dist/apollo3.d.mts",
        "default": "./dist/apollo3.mjs"
      },
      "require": {
        "types": "./dist/apollo3.d.ts",
        "default": "./dist/apollo3.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "apollo3": [
        "./dist/apollo3.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "check:dist": "node scripts/check-dist.mjs",
    "check:types-ts45": "pnpm --filter types-ts45 run typecheck",
    "lint": "oxlint --type-aware",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "server:setup": "cd test/server && mix deps.get && mix compile",
    "size": "size-limit",
    "publint": "publint --strict",
    "attw": "attw --pack .",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "peerDependencies": {
    "@apollo/client": "^3.4.0 || ^4.0.0",
    "graphql": "^15.0.0 || ^16.0.0 || ^17.0.0",
    "phoenix": ">=1.6.0 <2.0.0"
  },
  "devDependencies": {
    "@apollo/client": "4.3.5",
    "@apollo/client-3": "npm:@apollo/client@3.4.17",
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@size-limit/preset-small-lib": "14.3.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/phoenix": "1.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "5.0.5",
    "graphql": "17.0.2",
    "jsdom": "30.1.3",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "phoenix": "1.8.16",
    "phoenix-1.6": "npm:phoenix@1.6.17",
    "phoenix-1.8.8": "npm:phoenix@1.8.8",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rxjs": "7.8.2",
    "size-limit": "14.3.0",
    "tsdown": "0.23.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "ws": "8.22.0"
  }
}
