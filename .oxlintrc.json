{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "promise",
    "vitest",
    "jsdoc"
  ],
  "jsPlugins": ["./scripts/oxlint-naming.mjs"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error"
  },
  "rules": {
    "apollo-link-absinthe/naming-convention": "error",
    "eqeqeq": "error",
    "no-console": "error",
    "no-param-reassign": "error",
    "no-unused-vars": "error",
    "import/no-default-export": "error",
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-expect-error": "allow-with-description",
        "ts-ignore": "allow-with-description",
        "minimumDescriptionLength": 10
      }
    ],
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/no-confusing-void-expression": [
      "error",
      { "ignoreArrowShorthand": true }
    ],
    "typescript/prefer-readonly-parameter-types": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/strict-void-return": "off",
    "jsdoc/require-param": "off",
    "jsdoc/require-returns": "off",
    "max-lines": "off",
    "max-lines-per-function": "off",
    "max-classes-per-file": "off",
    "import/max-dependencies": "off",
    "unicorn/no-array-sort": "off",
    "promise/always-return": ["error", { "ignoreLastCallback": true }],
    "unicorn/no-useless-undefined": ["error", { "checkArguments": false }]
  },
  "overrides": [
    {
      "files": ["test/**"],
      "rules": {
        "typescript/unbound-method": "off"
      }
    },
    {
      "files": ["scripts/**", "test/support/globalSetup.ts", "*.config.mts"],
      "rules": {
        "no-await-in-loop": "off"
      }
    },
    {
      "files": ["scripts/check-dist.mjs"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["*.config.mts", "*.config.mjs", "scripts/oxlint-naming.mjs"],
      "rules": {
        "import/no-default-export": "off"
      }
    }
  ],
  "ignorePatterns": [
    "test/server/**",
    "test/types-ts45/**",
    "dist/**",
    "coverage/**"
  ]
}
